{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "memory:clear": "tsx src/scripts/clear-memories.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test:offline": "tsx src/scripts/offline.run.ts",
    "check:live:prompt": "tsx src/scripts/prompt.live.ts",
    "check:live:persona": "tsx src/scripts/persona.live.ts",
    "check:live:meaning": "tsx src/scripts/meaning.live.ts",
    "check:live:between": "tsx src/scripts/between.live.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "undici": "^8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
