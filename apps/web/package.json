{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:identity-race": "tsx scripts/identity-race.check.ts",
    "check:live-session-lifecycle": "tsx scripts/live-session-lifecycle.check.ts",
    "check:audio-playback": "tsx scripts/audio-playback.check.ts",
    "check:connection-feedback": "tsx scripts/connection-feedback.check.ts",
    "check:reminder-client": "tsx scripts/reminder-client.check.ts",
    "check:due-wait": "tsx scripts/due-wait.check.ts",
    "check:turn-transcript": "tsx scripts/turn-transcript.check.ts",
    "check:consolidate-result": "tsx scripts/consolidate-result.check.ts",
    "check:consolidation-payload": "tsx scripts/consolidation-payload.check.ts",
    "check:consolidation-outbox": "tsx scripts/consolidation-outbox.check.ts",
    "check:consolidation-handoff": "tsx scripts/consolidation-handoff.check.ts",
    "check:consolidation-drain": "tsx scripts/consolidation-drain.check.ts",
    "check:consolidation-drain-wire": "tsx scripts/consolidation-drain-wire.check.ts",
    "check:consolidation-refresh-recovery": "tsx scripts/consolidation-refresh-recovery.check.ts",
    "check:consolidation-isolated-drain": "tsx scripts/consolidation-isolated-drain.check.ts",
    "check:consolidation-flush-handoff": "tsx scripts/consolidation-flush-handoff.check.ts",
    "check:consolidation-cleanup-handoff": "tsx scripts/consolidation-cleanup-handoff.check.ts",
    "check:vite-proxy-auth": "tsx scripts/vite-proxy-auth.check.ts",
    "check:vite-dev-proxy-auth": "tsx scripts/vite-dev-proxy-auth.check.ts",
    "check:companion-token-leak": "tsx scripts/companion-token-leak.check.ts",
    "check:e2e:consolidation-intercept-p0": "playwright test -c playwright.config.ts --project=chromium-p0",
    "check:e2e:consolidation-refresh-p1a": "playwright test -c playwright.config.ts --project=chromium-p1a",
    "check:e2e:consolidation-app-origin-p1b": "playwright test -c playwright.config.ts --project=chromium-p1b",
    "check:e2e:consolidation-startup-drain-p1c": "playwright test -c playwright.config.ts --project=chromium-p1c",
    "check:p1c-origin": "tsx scripts/p1c-origin.check.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
