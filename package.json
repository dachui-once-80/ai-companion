{
  "name": "ai-companion",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:server:local": "node scripts/dev-with-token.mjs server",
    "dev:web:local": "node scripts/dev-with-token.mjs web",
    "dev:local": "node scripts/dev-with-token.mjs all",
    "check:dev-with-token": "node scripts/dev-with-token.check.mjs",
    "check:web:type": "pnpm --filter web exec tsc -b --pretty false",
    "check:web:lint": "pnpm --filter web lint",
    "check:web:build": "pnpm --filter web build",
    "check:server:type": "pnpm --filter server typecheck",
    "check:server:lint": "pnpm --filter server lint",
    "check:offline": "pnpm --filter server test:offline",
    "check:consolidate-idempotency": "pnpm --filter server check:consolidate-idempotency",
    "check:consolidation-http-idempotency": "pnpm --filter server check:consolidation-http-idempotency",
    "check:web:live-session": "pnpm --filter web check:live-session-lifecycle",
    "check:web:audio-playback": "pnpm --filter web check:audio-playback",
    "check:web:connection-feedback": "pnpm --filter web check:connection-feedback",
    "check:web:reminder-client": "pnpm --filter web check:reminder-client",
    "check:web:due-wait": "pnpm --filter web check:due-wait",
    "check:web:turn-transcript": "pnpm --filter web check:turn-transcript",
    "check:web:consolidate-result": "pnpm --filter web check:consolidate-result",
    "check:web:consolidation-payload": "pnpm --filter web check:consolidation-payload",
    "check:web:consolidation-outbox": "pnpm --filter web check:consolidation-outbox",
    "check:web:consolidation-handoff": "pnpm --filter web check:consolidation-handoff",
    "check:web:consolidation-drain": "pnpm --filter web check:consolidation-drain",
    "check:web:consolidation-drain-wire": "pnpm --filter web check:consolidation-drain-wire",
    "check:web:consolidation-refresh-recovery": "pnpm --filter web check:consolidation-refresh-recovery",
    "check:web:consolidation-isolated-drain": "pnpm --filter web check:consolidation-isolated-drain",
    "check:web:consolidation-flush-handoff": "pnpm --filter web check:consolidation-flush-handoff",
    "check:web:consolidation-cleanup-handoff": "pnpm --filter web check:consolidation-cleanup-handoff",
    "check:web:vite-proxy-auth": "pnpm --filter web check:vite-proxy-auth",
    "check:web:vite-dev-proxy-auth": "pnpm --filter web check:vite-dev-proxy-auth",
    "check:web:companion-token-leak": "pnpm --filter web check:companion-token-leak",
    "check:web:e2e:consolidation-intercept-p0": "pnpm --filter web check:e2e:consolidation-intercept-p0",
    "check:web:e2e:consolidation-refresh-p1a": "pnpm --filter web check:e2e:consolidation-refresh-p1a",
    "check:web:e2e:consolidation-app-origin-p1b": "pnpm --filter web check:e2e:consolidation-app-origin-p1b",
    "check:web:e2e:consolidation-startup-drain-p1c": "pnpm --filter web check:e2e:consolidation-startup-drain-p1c",
    "check:web:p1c-origin": "pnpm --filter web check:p1c-origin",
    "check:server:reminder-claim": "pnpm --filter server exec tsx src/scripts/reminder-claim.check.ts",
    "check": "pnpm check:web:type && pnpm check:web:lint && pnpm check:web:build && pnpm check:server:type && pnpm check:server:lint && pnpm check:offline && pnpm check:web:live-session && pnpm check:web:audio-playback && pnpm check:web:connection-feedback && pnpm check:web:reminder-client && pnpm check:web:due-wait && pnpm check:web:turn-transcript && pnpm check:web:consolidate-result && pnpm check:web:consolidation-payload && pnpm check:web:consolidation-outbox && pnpm check:web:consolidation-handoff && pnpm check:web:consolidation-drain && pnpm check:web:consolidation-drain-wire && pnpm check:web:consolidation-refresh-recovery && pnpm check:web:consolidation-isolated-drain && pnpm check:web:consolidation-flush-handoff && pnpm check:web:consolidation-cleanup-handoff && pnpm check:web:vite-proxy-auth && pnpm check:web:vite-dev-proxy-auth && pnpm check:web:companion-token-leak && pnpm check:server:reminder-claim && pnpm --filter web check:identity-race"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "@google/genai",
      "protobufjs"
    ]
  }
